# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# PostgreSQL password for the taxnavi user.
POSTGRES_PASSWORD=

# JWT signing secret: 32+ random characters.
# PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=

# Where the frontend is served (Paystack callback + CORS). Netlify example: https://taxnav.netlify.app
FRONTEND_URL=http://localhost:3000

# URL browsers use to reach the API (baked into the frontend build).
PUBLIC_API_URL=http://localhost:5000/api

# Paystack (test mode). Leave blank to disable payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_SME_PLAN_CODE=
PAYSTACK_ALLOW_LIVE_KEYS=false

# Host ports
API_PORT=5000
FRONTEND_PORT=3000

# AI assistant (RAG). Google AI Studio API key: https://aistudio.google.com/apikey — leave blank to run the
# rules-only assistant. Put the real value in .env (git-ignored), never in this file.
GEMINI_API_KEY=
# Email of the account allowed to manage the AI knowledge base (upload/index/evaluate).
ADMIN_EMAIL=
