# Environment variables template for development
# Copy this file to .env.local and fill in your values

# Database
# For LocalDB: (localdb)\mssqllocaldb
DATABASE_CONNECTION_STRING=Data Source=(localdb)\\mssqllocaldb;Initial Catalog=TaxNavi;Integrated Security=true;

# JWT Configuration
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long-change-in-production
JWT_ISSUER=TaxNavi.ai
JWT_AUDIENCE=TaxNavi.Users
JWT_EXPIRATION_MINUTES=1440

# Azure Services (Optional - leave blank if not using)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-35-turbo

# Azure Blob Storage
AZURE_BLOB_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=tax-reports

# Payment Provider (Paystack)
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key

# API Settings
ASPNETCORE_URLS=http://+:5000
ASPNETCORE_ENVIRONMENT=Development
